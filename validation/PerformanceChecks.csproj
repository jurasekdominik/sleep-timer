<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType><TargetFramework>net48</TargetFramework>
    <UseWPF>true</UseWPF><UseWindowsForms>true</UseWindowsForms><LangVersion>10</LangVersion>
    <StartupObject>SleepTimer.PerformanceChecks</StartupObject><GenerateAssemblyInfo>false</GenerateAssemblyInfo>
    <EnableDefaultCompileItems>false</EnableDefaultCompileItems>
    <SleepTimerSourceRoot Condition="'$(SleepTimerSourceRoot)' == ''">../src</SleepTimerSourceRoot>
  </PropertyGroup>
  <ItemGroup>
    <Reference Include="UIAutomationClient"/><Reference Include="UIAutomationTypes"/>
    <Compile Include="$(SleepTimerSourceRoot)/*.cs"/><Compile Include="PerformanceChecks.cs"/>
    <Resource Include="$(SleepTimerSourceRoot)/../assets/SleepTimer.ico" Link="assets/SleepTimer.ico"/>
  </ItemGroup>
</Project>
